# Copy this file to .env and fill values before running locally.
# Do NOT commit your real secrets.

# MongoDB connection string (use MongoDB Atlas connection string or self-hosted URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret used to sign tokens
JWT_SECRET=your_jwt_secret_here

# Server port (optional)
PORT=5000

# Node environment
NODE_ENV=development

# Frontend: base API url used by the Vite app (set in Vercel as VITE_API_BASE_URL)
VITE_API_BASE_URL=http://localhost:5000/api
